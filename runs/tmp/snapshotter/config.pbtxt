name: "snapshotter"
platform: "onnxruntime_onnx"
input {
  name: "stream"
  data_type: TYPE_FP32
  dims: 2
  dims: 2
  dims: 65536
}
output {
  name: "strain"
  data_type: TYPE_FP32
  dims: 2
  dims: 2
  dims: 208768
}
instance_group {
  count: 8
  kind: KIND_GPU
}
parameters {
  key: "intra_op_thread_count"
  value: { string_value: "4" }
}
parameters {
  key: "inter_op_thread_count"
  value: { string_value: "4" }
}
sequence_batching {
  max_sequence_idle_microseconds: 60000000000
  direct {
  }
  state {
    input_name: "input_snapshot"
    output_name: "output_snapshot"
    data_type: TYPE_FP32
    dims: 2
    dims: 2
    dims: 143232
    initial_state {
      data_type: TYPE_FP32
      dims: 2
      dims: 2
      dims: 143232
      zero_data: true
      name: "snapshot"
    }
  }
}
